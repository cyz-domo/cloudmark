{
  "project_description": "Cloudmark 是一个基于云的书签收集工具，允许用户一键保存和组织书签，并可从任何设备访问。核心功能是通过书签小工具(bookmarklet)实现快速保存网页。",
  
  "architecture": {
    "frontend": "React 19 SPA (Vite) + shadcn UI，高信息密度列表与键盘优先交互",
    "backend": "Hono on Cloudflare Workers",
    "styling": "Tailwind CSS + shadcn 设计系统",
    "storage": "Cloudflare D1 主存储；KV 仅用于旧数据只读迁移",
    "security": "写操作需要 write token（SHA-256 哈希存 D1，明文在 localStorage/bookmarklet）",
    "deployment": "wrangler deploy（无 OpenNext / Next.js）",
    "language": "TypeScript 7"
  },
  
  "code_standards": {
    "formatting": "eslint + typescript-eslint",
    "typescript": "严格类型检查，TypeScript 7",
    "component_structure": "功能组件 + Hooks；UI 遵循 shadcn 模式"
  },
  
  "key_concepts": {
    "bookmarklet": "浏览器书签栏一键保存当前页面的 JavaScript 片段",
    "cloud_storage": "书签数据存储在 Cloudflare D1，跨设备访问",
    "internationalization": "中英文，localStorage 切换",
    "edge_computing": "Cloudflare Workers 边缘运行时"
  },
  
  "folder_structure": {
    "src/client": "React SPA 入口、页面、hooks、i18n",
    "src/worker": "Hono API 与 bookmarklet 入口",
    "src/shared": "前后端共享类型、schema、db、security",
    "src/components/ui": "shadcn UI 组件",
    "migrations": "D1 SQL migrations"
  },
  
  "ai_guidance": {
    "preferred_patterns": [
      "Hono JSON API + React fetch 客户端",
      "键盘快捷键与高密度列表 UI",
      "组件级 i18n",
      "Cloudflare Workers + D1 模式"
    ],
    "avoid": [
      "Next.js / OpenNext / zsa server actions",
      "使用客户端存储作为主要数据存储",
      "过度复杂的状态管理",
      "直接 DOM 操作",
      "大型内联样式"
    ]
  }
}
